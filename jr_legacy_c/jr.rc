// Version resource for jr.exe. SignPath Foundation requires product name and version
// attributes on every signed binary, consistent across builds. CI passes JR_VER (commas)
// and JR_VER_STR (dots) from the release tag; a local build gets the defaults below.
#include <winver.h>

#ifndef JR_VER
#define JR_VER 1,0,0,0
#endif
#ifndef JR_VER_STR
#define JR_VER_STR "1.0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    JR_VER
 PRODUCTVERSION JR_VER
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "littlejlib"
            VALUE "FileDescription",  "jr - Java Runner"
            VALUE "FileVersion",      JR_VER_STR
            VALUE "InternalName",     "jr"
            VALUE "LegalCopyright",   "Apache License 2.0"
            VALUE "OriginalFilename", "jr.exe"
            VALUE "ProductName",      "jr"
            VALUE "ProductVersion",   JR_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
