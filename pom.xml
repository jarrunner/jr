<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.jarrunner</groupId>
  <artifactId>jr</artifactId>
  <version>1.3.0</version>
  <packaging>jar</packaging>

  <description>jr, a Java/TeaVM launcher that picks java.exe/javaw.exe (or posix_spawn's java on Linux/macOS), reads the config baked into its exe, manages an AOT cache, and auto-installs a matching JDK on Windows. Supersedes jr_legacy_c, the original C implementation, as the primary implementation - see this repo's CLAUDE.md for the platform decision.</description>
  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- TeaVM from the jarrunner/teavm fork (branch 0.16.0-jr): upstream 0.16.0 plus the C-backend fixes that
         postprocess.ps1 used to patch into the generated C (PRP-37). Built with -Pteavm.publish.groupId. -->
    <teavm.groupId>io.github.jarrunner.teavm</teavm.groupId>
    <teavm.version>0.16.0-jr.1</teavm.version>
    <!-- The native build (profile windows): teavm-c-maven-plugin (repo jarrunner/teavm-c-maven-plugin) compiles TeaVM's C. -->
    <teavmc.version>1.0.0</teavmc.version>
    <jr.src>src/main/java</jr.src>
    <jr.zig>zig</jr.zig>
    <jr.dist>dist</jr.dist>
    <jr.noicon>false</jr.noicon>
    <jr.nostamp>false</jr.nostamp>
    <jr.icon>${project.basedir}/icon/jr-icon.ico</jr.icon>
    <jr.manifest>${project.basedir}/src/main/windows/app.manifest</jr.manifest>
    <!-- Version information stamped into jr's own Windows exes: an exe with none (no company, product or
         description) is what antivirus heuristics distrust; 1.2.0 shipped without it and Defender flagged it. -->
    <jr.version.quad>${project.version}.0</jr.version.quad>
    <jr.version.company>jarrunner</jr.version.company>
    <jr.version.product>jr</jr.version.product>
    <jr.version.description>jr - Java Runner launcher</jr.version.description>
    <jr.version.copyright>Copyright (c) the jarrunner authors. Apache License 2.0</jr.version.copyright>
    <!-- teavm-native-check (PRP-35): the native-memory rules, enforced by javac. the profiles read this same
         line, so both source trees are checked against one configuration. -->
    <!-- PRP-35 phase 3: the Checks.ON constant comes from src/checks-off (release) or, with -Dchecks, src/checks-on. -->
    <jr.checks.src>src/checks-off/java</jr.checks.src>
    <!-- teavm-native-check comes from Maven Central (repo jarrunner/teavm-native-check, split out of jr by PRP-37). -->
    <nativecheck.version>1.0.0</nativecheck.version>
    <nativecheck>tracked=jarrunner.jr.ReError takes=jarrunner.jr.N.handOver wrappers=jarrunner.jr.Buf trust=jarrunner.jr.Buf.wrap scope=jarrunner.jr.N.memScoped alloc=jarrunner.jr.N.alloc raw=jarrunner.jr.N,jarrunner.jr.Arena,jarrunner.jr.Buf,jarrunner.jr.WinApi,jarrunner.jr.WinOffsets,jarrunner.jr.PosixApi,jarrunner.jr.PosixOffsets</nativecheck>
  </properties>
  <dependencies>
    <dependency>
      <groupId>${teavm.groupId}</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>checks</id>
      <activation><property><name>checks</name></property></activation>
      <properties>
        <jr.checks.src>src/checks-on/java</jr.checks.src>
        <jr.dist>dist-checks</jr.dist>
        <jr.nostamp>true</jr.nostamp>
      </properties>
    </profile>
    <!-- mvn package on Windows: TeaVM -> target/c/all.c -> llvm-mingw clang (on PATH) -> ${jr.dist}/jr-windows-<arch>.exe,
         then jr's icon and manifest stamped on by a third, unstamped x86_64 build (an exe cannot edit itself).
         -Djr.dist=<dir> picks the folder, -Djr.noicon=true leaves the icon off, -Dteavmc.targets=x86_64,editor builds a subset. -->
    <profile>
      <id>windows</id>
      <activation><os><family>windows</family></os><property><name>!linux</name></property></activation>
      <build>
        <plugins>
          <plugin>
            <groupId>${teavm.groupId}</groupId>
            <artifactId>teavm-maven-plugin</artifactId>
            <version>${teavm.version}</version>
            <executions>
              <execution>
                <id>teavm-c</id>
                <phase>process-classes</phase>
                <goals><goal>compile</goal></goals>
                <configuration>
                  <targetType>C</targetType>
                  <mainClass>jarrunner.jr.Jr</mainClass>
                  <targetDirectory>${project.build.directory}/c</targetDirectory>
                  <minHeapSize>4</minHeapSize>
                  <maxHeapSize>32</maxHeapSize>
                  <optimizationLevel>ADVANCED</optimizationLevel>
                  <assertionsRemoved>true</assertionsRemoved>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>io.github.jarrunner</groupId>
            <artifactId>teavm-c-maven-plugin</artifactId>
            <version>${teavmc.version}</version>
            <executions>
              <execution>
                <id>native</id>
                <goals><goal>compile</goal></goals>
                <configuration>
                  <includes><include>bindings/windows</include></includes>
                  <args>
                    <arg>-Oz</arg><arg>-flto</arg><arg>-ffunction-sections</arg><arg>-fdata-sections</arg>
                    <arg>-Wl,--gc-sections</arg><arg>-Wl,--no-insert-timestamp</arg><arg>-s</arg>
                  </args>
                  <libraries>
                    <library>winhttp</library><library>bcrypt</library><library>comctl32</library><library>version</library>
                    <library>crypt32</library><library>mssign32</library><library>gdi32</library>
                  </libraries>
                  <targets>
                    <target><id>x86_64</id><compiler>x86_64-w64-mingw32-clang</compiler><output>${jr.dist}/jr-windows-x86_64.exe</output></target>
                    <target><id>arm64</id><compiler>aarch64-w64-mingw32-clang</compiler><output>${jr.dist}/jr-windows-arm64.exe</output></target>
                    <target><id>editor</id><compiler>x86_64-w64-mingw32-clang</compiler><output>target/jr-icon-editor.exe</output></target>
                  </targets>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.4</version>
            <configuration>
              <executable>${project.build.directory}/jr-icon-editor.exe</executable>
              <skip>${jr.noicon}</skip>
            </configuration>
            <executions>
              <execution>
                <id>icon-x86_64</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <arguments><argument>-Xjr:edit=${jr.dist}/jr-windows-x86_64.exe</argument><argument>-Xjr:icon=${jr.icon}</argument><argument>-Xjr:manifest=${jr.manifest}</argument><argument>-Xjr:version=${jr.version.quad}</argument><argument>-Xjr:version.CompanyName=${jr.version.company}</argument><argument>-Xjr:version.ProductName=${jr.version.product}</argument><argument>-Xjr:version.FileDescription=${jr.version.description}</argument><argument>-Xjr:version.LegalCopyright=${jr.version.copyright}</argument><argument>-Xjr:version.InternalName=jr</argument><argument>-Xjr:version.OriginalFilename=jr.exe</argument></arguments>
                </configuration>
              </execution>
              <execution>
                <id>icon-arm64</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <arguments><argument>-Xjr:edit=${jr.dist}/jr-windows-arm64.exe</argument><argument>-Xjr:icon=${jr.icon}</argument><argument>-Xjr:manifest=${jr.manifest}</argument><argument>-Xjr:version=${jr.version.quad}</argument><argument>-Xjr:version.CompanyName=${jr.version.company}</argument><argument>-Xjr:version.ProductName=${jr.version.product}</argument><argument>-Xjr:version.FileDescription=${jr.version.description}</argument><argument>-Xjr:version.LegalCopyright=${jr.version.copyright}</argument><argument>-Xjr:version.InternalName=jr</argument><argument>-Xjr:version.OriginalFilename=jr.exe</argument></arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- -Djr.noicon=true (the builds jr-maven-plugin bundles): no icon, but the same version information,
         which the plugin overwrites with the app's own. -->
    <profile>
      <id>windows-noicon</id>
      <activation><os><family>windows</family></os><property><name>jr.noicon</name><value>true</value></property></activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>version-x86_64</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <skip>${jr.nostamp}</skip>
                  <arguments><argument>-Xjr:edit=${jr.dist}/jr-windows-x86_64.exe</argument><argument>-Xjr:version=${jr.version.quad}</argument><argument>-Xjr:version.CompanyName=${jr.version.company}</argument><argument>-Xjr:version.ProductName=${jr.version.product}</argument><argument>-Xjr:version.FileDescription=${jr.version.description}</argument><argument>-Xjr:version.LegalCopyright=${jr.version.copyright}</argument><argument>-Xjr:version.InternalName=jr</argument><argument>-Xjr:version.OriginalFilename=jr.exe</argument></arguments>
                </configuration>
              </execution>
              <execution>
                <id>version-arm64</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <skip>${jr.nostamp}</skip>
                  <arguments><argument>-Xjr:edit=${jr.dist}/jr-windows-arm64.exe</argument><argument>-Xjr:version=${jr.version.quad}</argument><argument>-Xjr:version.CompanyName=${jr.version.company}</argument><argument>-Xjr:version.ProductName=${jr.version.product}</argument><argument>-Xjr:version.FileDescription=${jr.version.description}</argument><argument>-Xjr:version.LegalCopyright=${jr.version.copyright}</argument><argument>-Xjr:version.InternalName=jr</argument><argument>-Xjr:version.OriginalFilename=jr.exe</argument></arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- mvn package -Dlinux: the POSIX tree (src/main/java-posix, PosixJr) -> TeaVM -> zig cc -> ${jr.dist}/jr-linux-x86_64,
         cross-compiled from any OS. -Djr.zig=<path to zig> when zig is not on PATH. -->
    <profile>
      <id>linux</id>
      <activation><property><name>linux</name></property></activation>
      <properties><jr.src>src/main/java-posix</jr.src></properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>os-sources</id>
                <phase>generate-sources</phase>
                <goals><goal>add-source</goal></goals>
                <configuration><sources><source>src/main/java-linux</source><source>bindings/posix/gen/linux_x64</source></sources></configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>${teavm.groupId}</groupId>
            <artifactId>teavm-maven-plugin</artifactId>
            <version>${teavm.version}</version>
            <executions>
              <execution>
                <id>teavm-c</id>
                <phase>process-classes</phase>
                <goals><goal>compile</goal></goals>
                <configuration>
                  <targetType>C</targetType>
                  <mainClass>jarrunner.jr.PosixJr</mainClass>
                  <targetDirectory>${project.build.directory}/c</targetDirectory>
                  <minHeapSize>4</minHeapSize>
                  <maxHeapSize>32</maxHeapSize>
                  <optimizationLevel>ADVANCED</optimizationLevel>
                  <assertionsRemoved>true</assertionsRemoved>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>io.github.jarrunner</groupId>
            <artifactId>teavm-c-maven-plugin</artifactId>
            <version>${teavmc.version}</version>
            <executions>
              <execution>
                <id>native</id>
                <goals><goal>compile</goal></goals>
                <configuration>
                  <includes><include>bindings/posix</include></includes>
                  <args><arg>cc</arg><arg>-O2</arg><arg>-w</arg><arg>-D_GNU_SOURCE</arg></args>
                  <targets>
                    <target><id>x86_64</id><compiler>${jr.zig}</compiler><output>${jr.dist}/jr-linux-x86_64</output><args><arg>-target</arg><arg>x86_64-linux-gnu</arg></args></target>
                  </targets>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- mvn package on a Mac (Apple clang, Xcode command line tools): the POSIX tree with the macOS Os and bindings ->
         TeaVM -> ${jr.dist}/jr-macos-arm64, jr-macos-x86_64 and jr-macos (universal), each with an empty 16 KB __DATA,__jrc
         section that jr-maven-plugin fills with an app's config, each signed ad hoc. Built by CI on a macOS runner. -->
    <profile>
      <id>macos</id>
      <activation><os><family>mac</family></os><property><name>!linux</name></property></activation>
      <properties><jr.src>src/main/java-posix</jr.src></properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>os-sources</id>
                <phase>generate-sources</phase>
                <goals><goal>add-source</goal></goals>
                <configuration><sources><source>src/main/java-macos</source><source>bindings/posix/gen/macos_arm64</source></sources></configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>${teavm.groupId}</groupId>
            <artifactId>teavm-maven-plugin</artifactId>
            <version>${teavm.version}</version>
            <executions>
              <execution>
                <id>teavm-c</id>
                <phase>process-classes</phase>
                <goals><goal>compile</goal></goals>
                <configuration>
                  <targetType>C</targetType>
                  <mainClass>jarrunner.jr.PosixJr</mainClass>
                  <targetDirectory>${project.build.directory}/c</targetDirectory>
                  <minHeapSize>4</minHeapSize>
                  <maxHeapSize>32</maxHeapSize>
                  <optimizationLevel>ADVANCED</optimizationLevel>
                  <assertionsRemoved>true</assertionsRemoved>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>io.github.jarrunner</groupId>
            <artifactId>teavm-c-maven-plugin</artifactId>
            <version>${teavmc.version}</version>
            <executions>
              <execution>
                <id>native</id>
                <goals><goal>compile</goal></goals>
                <configuration>
                  <includes><include>bindings/posix</include></includes>
                  <args>
                    <arg>-mmacosx-version-min=13.0</arg><arg>-Oz</arg><arg>-flto</arg><arg>-w</arg>
                    <arg>-Wl,-dead_strip</arg><arg>-Wl,-S</arg><arg>-Wl,-x</arg>
                    <arg>-Wl,-sectcreate,__DATA,__jrc,bindings/posix/jrc-slot.bin</arg>
                  </args>
                  <targets>
                    <target><id>arm64</id><compiler>clang</compiler><output>${jr.dist}/jr-macos-arm64</output><args><arg>-arch</arg><arg>arm64</arg></args></target>
                    <target><id>x86_64</id><compiler>clang</compiler><output>${jr.dist}/jr-macos-x86_64</output><args><arg>-arch</arg><arg>x86_64</arg></args></target>
                    <target><id>universal</id><compiler>clang</compiler><output>${jr.dist}/jr-macos</output><args><arg>-arch</arg><arg>arm64</arg><arg>-arch</arg><arg>x86_64</arg></args></target>
                  </targets>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.4</version>
            <configuration><executable>codesign</executable></configuration>
            <executions>
              <!-- the generated bindings' static asserts, checked against the real macOS SDK before anything is built -->
              <execution>
                <id>verify-bindings-arm64</id>
                <phase>validate</phase>
                <goals><goal>exec</goal></goals>
                <configuration><executable>clang</executable><arguments><argument>-arch</argument><argument>arm64</argument><argument>-fsyntax-only</argument><argument>-w</argument><argument>-I</argument><argument>bindings/posix</argument><argument>bindings/posix/verify-posix-macos_arm64.c</argument></arguments></configuration>
              </execution>
              <execution>
                <id>verify-bindings-x86_64</id>
                <phase>validate</phase>
                <goals><goal>exec</goal></goals>
                <configuration><executable>clang</executable><arguments><argument>-arch</argument><argument>x86_64</argument><argument>-fsyntax-only</argument><argument>-w</argument><argument>-I</argument><argument>bindings/posix</argument><argument>bindings/posix/verify-posix-macos_x64.c</argument></arguments></configuration>
              </execution>
              <execution>
                <id>sign-arm64</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration><arguments><argument>-s</argument><argument>-</argument><argument>-f</argument><argument>${jr.dist}/jr-macos-arm64</argument></arguments></configuration>
              </execution>
              <execution>
                <id>sign-x86_64</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration><arguments><argument>-s</argument><argument>-</argument><argument>-f</argument><argument>${jr.dist}/jr-macos-x86_64</argument></arguments></configuration>
              </execution>
              <execution>
                <id>sign-universal</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration><arguments><argument>-s</argument><argument>-</argument><argument>-f</argument><argument>${jr.dist}/jr-macos</argument></arguments></configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <build>
    <sourceDirectory>${jr.src}</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>checks-source</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration><sources><source>${jr.checks.src}</source></sources></configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>io.github.jarrunner</groupId>
              <artifactId>teavm-native-check</artifactId>
              <version>${nativecheck.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Xplugin:NativeCheck ${nativecheck}</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
