<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.jarrunner</groupId>
  <artifactId>jr</artifactId>
  <version>1.1.0</version>
  <packaging>jar</packaging>

  <description>jr, a Java/TeaVM launcher that picks java.exe/javaw.exe (or posix_spawn's java on Linux/macOS), reads a sibling .jrc config, manages an AOT cache, and auto-installs a matching JDK on Windows. Supersedes jr_legacy_c, the original C implementation, as the primary implementation - see this repo's CLAUDE.md for the platform decision.</description>
  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- TeaVM from the jarrunner/teavm fork (branch 0.16.0-jr): upstream 0.16.0 plus the C-backend fixes that
         postprocess.ps1 used to patch into the generated C (PRP-37). Built with -Pteavm.publish.groupId. -->
    <teavm.groupId>io.github.jarrunner.teavm</teavm.groupId>
    <teavm.version>0.16.0-jr.1</teavm.version>
    <!-- teavm-native-check (PRP-35): the native-memory rules, enforced by javac. build-posix.sh reads this same
         line, so both source trees are checked against one configuration. -->
    <!-- PRP-35 phase 3: the Checks.ON constant comes from src/checks-off (release) or, with -Dchecks, src/checks-on. -->
    <jr.checks.src>src/checks-off/java</jr.checks.src>
    <!-- teavm-native-check comes from Maven Central (repo jarrunner/teavm-native-check, split out of jr by PRP-37). -->
    <nativecheck.version>1.0.0</nativecheck.version>
    <nativecheck>tracked=jarrunner.jr.ReError takes=jarrunner.jr.N.handOver wrappers=jarrunner.jr.Buf trust=jarrunner.jr.Buf.wrap scope=jarrunner.jr.N.memScoped alloc=jarrunner.jr.N.alloc raw=jarrunner.jr.N,jarrunner.jr.Arena,jarrunner.jr.Buf,jarrunner.jr.WinApi,jarrunner.jr.WinOffsets,jarrunner.jr.PosixApi,jarrunner.jr.PosixOffsets</nativecheck>
  </properties>
  <dependencies>
    <dependency>
      <groupId>${teavm.groupId}</groupId>
      <artifactId>teavm-tooling</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>${teavm.groupId}</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>checks</id>
      <activation><property><name>checks</name></property></activation>
      <properties><jr.checks.src>src/checks-on/java</jr.checks.src></properties>
    </profile>
  </profiles>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>checks-source</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration><sources><source>${jr.checks.src}</source></sources></configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>io.github.jarrunner</groupId>
              <artifactId>teavm-native-check</artifactId>
              <version>${nativecheck.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Xplugin:NativeCheck ${nativecheck}</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
