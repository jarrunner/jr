// WinHTTP (and LoadLibraryW/CreateProcessW/etc.) take LPCWSTR - UTF-16 wide
// strings - and there is no ANSI WinHTTP entry point to fall back to. Jux's
// documented String<->C marshaling is narrow (`const char*`) only. This
// tests whether a hand-built UTF-16 buffer + raw pointer can round-trip
// through a real wide-char Win32 call (GetFileAttributesW, compared against
// the already-proven ANSI GetFileAttributesExA path for the same file).

@extern(lib = "ucrt")
unsafe native {
    void* malloc(u64 size);
    void free(void* p);
}

@extern(lib = "kernel32")
unsafe native {
    u32 GetFileAttributesW(void* lpFileName);
    u32 GetFileAttributesA(String lpFileName);
}

// Build a NUL-terminated UTF-16LE buffer from a Jux String. Returns a
// malloc'd void* the caller must free.
public unsafe void* toWideString(String s) {
    u64 n = (u64) s.length();
    void* buf = malloc((n + 1) * 2);
    u16* p = buf as u16*;
    int i = 0;
    while (i < s.length()) {
        char c = s.charAt(i);
        *(p + i) = (u16) c;
        i = i + 1;
    }
    *(p + i) = (u16) 0;
    return buf;
}

public void main() {
    unsafe {
        String path = "jr.jux";
        u32 ansiAttrs = GetFileAttributesA(path);

        void* wide = toWideString(path);
        u32 wideAttrs = GetFileAttributesW(wide);
        free(wide);

        print($"ansiAttrs=$ansiAttrs wideAttrs=$wideAttrs match=${ansiAttrs == wideAttrs}");
    }
}
