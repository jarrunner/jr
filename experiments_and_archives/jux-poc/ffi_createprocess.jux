// Win32 FFI viability check for jr's actual, most struct-heavy call:
// CreateProcessA(STARTUPINFOA in, PROCESS_INFORMATION out), plus the
// console-handle plumbing (GetStdHandle/AttachConsole/GetConsoleMode)
// jr's launcher.c does around it. See launcher.c:1492-1524 for the C original.

@layout(c)
struct StartupInfo {
    u32 cb;
    void* lpReserved;
    void* lpDesktop;
    void* lpTitle;
    u32 dwX;
    u32 dwY;
    u32 dwXSize;
    u32 dwYSize;
    u32 dwXCountChars;
    u32 dwYCountChars;
    u32 dwFillAttribute;
    u32 dwFlags;
    u16 wShowWindow;
    u16 cbReserved2;
    void* lpReserved2;
    void* hStdInput;
    void* hStdOutput;
    void* hStdError;
}

@layout(c)
struct ProcessInformation {
    void* hProcess;
    void* hThread;
    u32 dwProcessId;
    u32 dwThreadId;
}

@extern(lib = "kernel32")
unsafe native {
    void* GetStdHandle(i32 nStdHandle);
    i32 AttachConsole(u32 dwProcessId);
    i32 GetConsoleMode(void* hConsoleHandle, out u32 lpMode);

    i32 CreateProcessA(
        void* lpApplicationName,
        String lpCommandLine,
        void* lpProcessAttributes,
        void* lpThreadAttributes,
        i32 bInheritHandles,
        u32 dwCreationFlags,
        void* lpEnvironment,
        void* lpCurrentDirectory,
        out StartupInfo lpStartupInfo,
        out ProcessInformation lpProcessInformation
    );

    u32 WaitForSingleObject(void* hHandle, u32 dwMilliseconds);
    i32 GetExitCodeProcess(void* hProcess, out u32 lpExitCode);
    i32 CloseHandle(void* hObject);
}

public void main() {
    unsafe {
        void* nullPtr = null;   // workaround: see note below

        // --- console handle plumbing, same shape as jr's isGuiMode()/spawn setup ---
        i32 couldAttach = AttachConsole(0xFFFFFFFF);   // ATTACH_PARENT_PROCESS = (DWORD)-1
        void* stdOut = GetStdHandle(-11);              // STD_OUTPUT_HANDLE = (DWORD)-11
        u32 mode = 0;
        i32 hasMode = GetConsoleMode(stdOut, out mode);
        print($"couldAttach=$couldAttach stdOut-nonnull=${stdOut != nullPtr} hasMode=$hasMode mode=$mode");

        // --- the real stress test: CreateProcessA with in/out structs ---
        StartupInfo si = new StartupInfo(
            0, nullPtr, nullPtr, nullPtr, 0, 0, 0, 0, 0, 0, 0,
            0x00000100,           // STARTF_USESTDHANDLES
            0, 0, nullPtr,
            GetStdHandle(-10), GetStdHandle(-11), GetStdHandle(-12)
        );
        si.cb = (u32) sizeof(StartupInfo);

        ProcessInformation pi = new ProcessInformation(nullPtr, nullPtr, 0, 0);

        i32 ok = CreateProcessA(
            nullPtr,
            "cmd.exe /c echo hello-from-jux-child",
            nullPtr, nullPtr,
            1,                    // bInheritHandles = TRUE
            0,
            nullPtr, nullPtr,
            out si,
            out pi
        );

        print($"CreateProcessA ok=$ok pid=${pi.dwProcessId} lastPi-nonnull=${pi.hProcess != null}");

        if (ok != 0) {
            u32 waitResult = WaitForSingleObject(pi.hProcess, 5000);
            u32 exitCode = 0;
            i32 gotExit = GetExitCodeProcess(pi.hProcess, out exitCode);
            print($"waitResult=$waitResult gotExit=$gotExit exitCode=$exitCode");
            CloseHandle(pi.hProcess);
            CloseHandle(pi.hThread);
        }
    }
}
