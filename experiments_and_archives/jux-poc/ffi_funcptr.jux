// Quick check: can a void* obtained from GetProcAddress be turned into a
// callable function pointer? This is exactly what jvm=dll's JLI_Launch path
// needs. The capability table in JUX-POINTERS-REFERENCES-GUIDE.md marks
// function-pointer values as "specced, not emitted yet" (the same row as
// transmute) - this test is to confirm that before writing it off.

@extern(lib = "kernel32")
unsafe native {
    void* GetModuleHandleA(String lpModuleName);
    void* GetProcAddress(void* hModule, String lpProcName);
    u32 GetCurrentProcessId();
}

public void main() {
    unsafe {
        void* kernel32 = GetModuleHandleA("kernel32.dll");
        void* proc = GetProcAddress(kernel32, "GetCurrentProcessId");
        print($"proc-nonnull=${proc != null}");

        // The actual question: can `proc` (a void*) be called as
        // fn() -> u32 ?  Trying the most natural spelling.
        fn() -> u32 asFn = proc as fn() -> u32;
        u32 pid = asFn();
        print($"pid=$pid");
    }
}
