// GetModuleFileNameA needs a pre-allocated MUTABLE output buffer (LPSTR),
// which Jux's `String` type can't provide (marshaling is read-only in both
// directions). Test whether a malloc'd byte buffer, written into by C, can
// be read back byte-by-byte via p[i] (READS via index are documented as
// working; only index-ASSIGNMENT hit a bug in the wide-string test).

@extern(lib = "ucrt")
unsafe native {
    void* malloc(u64 size);
    void free(void* p);
}

@extern(lib = "kernel32")
unsafe native {
    u32 GetModuleFileNameA(void* hModule, void* lpFilename, u32 nSize);
}

public void main() {
    unsafe {
        void* nullPtr = null;
        u32 bufSize = 512;
        void* buf = malloc((u64) bufSize);
        u32 len = GetModuleFileNameA(nullPtr, buf, bufSize);

        byte* p = buf as byte*;
        String result = "";
        int i = 0;
        while (i < (int) len) {
            byte b = *(p + i);
            result = result + ("" + (char) b);
            i = i + 1;
        }
        free(buf);

        print($"len=$len path=$result");
    }
}
