# The POSIX surface the Linux/macOS port of jr binds. THIS FILE IS THE SOURCE OF TRUTH: PosixApi.java
# and PosixOffsets.java are generated from it by gen-bindings-posix.sh - never hand-edit them.
# `releases=a` after a function's Java name: the call that closes what it returns; it becomes @Acquires("a") and
# teavm-native-check NC8 checks every caller closes it on every path (PRP-35 phase 5). Same syntax as winapi.symbols.
# `fails=V`: the value it returns on failure; it becomes @Fails("V") and NC10 makes callers test it (PRP-35 phase 8).
# --- functions (C name, Java name) ---
exit exit
getenv getenv fails=NULL
setenv setenv
fopen fopen releases=fclose fails=NULL
fputs fputs
fflush fflush
fclose fclose
fread fread
fwrite fwrite
write write
malloc malloc
free free
memset memset
time time
clock_gettime clockGettime
stat stat
access access
unlink unlink
rename rename
chmod chmod
symlink symlink
readlink readlink
mkdir mkdir
rmdir rmdir
opendir opendir releases=closedir fails=NULL
readdir readdir
closedir closedir
realpath realpath
getcwd getcwd
posix_spawn posixSpawn
waitpid waitpid
isatty isatty
uname uname
jx_wexitstatus wexitstatus
jx_wifexited wifexited
jx_environ getEnviron
dlopen dlopen fails=NULL
dlsym dlsym fails=NULL
jx_jli_start jliStart
# --- constants ---
O_RDONLY
F_OK
X_OK
W_OK
CLOCK_MONOTONIC
PATH_MAX
EINTR
DT_DIR
RTLD_NOW
# --- structs ---
struct:stat stat_t
struct:timespec timespec
struct:dirent dirent
struct:utsname utsname
