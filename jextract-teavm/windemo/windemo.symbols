# Callback types and function-like macros (PRP-19), bound from windows.h + stdlib.h
# --- a C function that takes a callback, and the callback's typedef ---
EnumWindows enumWindows
WNDENUMPROC
WNDPROC
# --- the same for the CRT's qsort, whose comparator has no typedef: the type of its 4th parameter ---
qsort
qsort(4) QsortCompar
# --- function-like macros: argument types given here, the result type comes from clang (or is checked against it) ---
macro:LOWORD loword short(int)
macro:HIWORD hiword (int)
macro:MAKELONG makeLong (int, int)
macro:MAKELPARAM makeLParam (int, int)
exit
